@startuml
title Backup System 用例图
left to right direction
skinparam shadowing false
skinparam backgroundColor white
skinparam actorStyle stickman
skinparam packageStyle rectangle

actor "普通使用者" as User
actor "部署维护者" as Operator

rectangle "Backup System" {
  usecase "UC-01\n管理目录任务" as Tasks
  usecase "UC-02\n配置筛选规则（P1）" as Filters
  usecase "UC-03\n扫描目录" as Scan
  usecase "UC-04\n执行备份" as Backup
  usecase "UC-05\n查看备份版本" as Versions
  usecase "UC-06\n还原数据" as Restore
  usecase "UC-07\n检查服务状态" as Status
  usecase "UC-08\n配置并启动服务" as Service
}

User -- Tasks
User -- Filters
User -- Scan
User -- Backup
User -- Versions
User -- Restore
User -- Status
Status -- Operator
Service -- Operator

legend bottom
  实线表示参与者与用例的关联，不表示执行顺序。
  UC-02 为 P1；其余用例为 P0。
  元数据为 UC-04 与 UC-06 的 P1 扩展行为。
endlegend
@enduml
